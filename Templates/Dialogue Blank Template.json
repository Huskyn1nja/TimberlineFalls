{
  "Changes": [
    // ============================================================
    // 1. CORE DIALOGUE
    // ============================================================
    {
      "LogName": "Core Dialogue - {{TargetNPC}}",
      "Action": "EditData",
      "Target": "Characters/Dialogue/{{ModId}}_{{TargetNPC}}",
      "Entries": {
        // --- INTRODUCTION ---
        "Introduction": "{{i18n:{{TargetNPC}}.Intro}}",

        // --- DAILY DIALOGUE (Low Priority) ---
        "Mon": "{{i18n:{{TargetNPC}}.Day.Mon}}",
        "Tue": "{{i18n:{{TargetNPC}}.Day.Tue}}",
        "Wed": "{{i18n:{{TargetNPC}}.Day.Wed}}",
        "Thu": "{{i18n:{{TargetNPC}}.Day.Thu}}",
        "Fri": "{{i18n:{{TargetNPC}}.Day.Fri}}",
        "Sat": "{{i18n:{{TargetNPC}}.Day.Sat}}",
        "Sun": "{{i18n:{{TargetNPC}}.Day.Sun}}",

        // --- SEASONAL VARIATIONS (Medium Priority) ---
        // Overrides "Mon", "Tue" etc. if defined for the current season
        "spring_Mon": "{{i18n:{{TargetNPC}}.Spring.Mon}}",
        "summer_Fri": "{{i18n:{{TargetNPC}}.Summer.Fri}}",
        "winter_Sun": "{{i18n:{{TargetNPC}}.Winter.Sun}}",

        // --- HEART LEVEL DIALOGUE (High Priority) ---
        // Syntax: Day + HeartLevel (e.g., Mon4 = Monday at 4+ hearts)
        "Mon4": "{{i18n:{{TargetNPC}}.Hearts4.Mon}}",
        "Fri8": "{{i18n:{{TargetNPC}}.Hearts8.Fri}}",
        
        // --- DATING & MARRIAGE ---
        "dating_Mon": "{{i18n:{{TargetNPC}}.Dating.Mon}}",
        "marriage_Mon": "{{i18n:{{TargetNPC}}.Marriage.Mon}}",
        "marriage_Rainy": "{{i18n:{{TargetNPC}}.Marriage.Rainy}}",

        // --- SPECIAL DATES & LORE ---
        // Trumps almost everything. Good for birthdays or death anniversaries.
        "spring_1": "{{i18n:{{TargetNPC}}.Date.Spring1}}",
        "winter_23": "{{i18n:{{TargetNPC}}.Date.Birthday}}",
        "winter_28": "{{i18n:{{TargetNPC}}.Date.EndOfYear}}",

        // --- WEATHER & STATUS ---
        "rain": "{{i18n:{{TargetNPC}}.Weather.Rain}}",
        "snow": "{{i18n:{{TargetNPC}}.Weather.Snow}}",
        "GreenRain": "{{i18n:{{TargetNPC}}.Weather.GreenRain}}",
        "GreenRainFinished": "{{i18n:{{TargetNPC}}.Weather.GreenRainAftermath}}",

        // --- LOCATION SPECIFIC ---
        // Triggered when speaking to NPC in these specific maps
        "Resort_Entering": "{{i18n:{{TargetNPC}}.Resort.Entry}}",
        "Resort_Shore": "{{i18n:{{TargetNPC}}.Resort.Shore}}",
        "Town": "{{i18n:{{TargetNPC}}.Location.Town}}",
        "Saloon": "{{i18n:{{TargetNPC}}.Location.Saloon}}",
        "BusStop": "{{i18n:{{TargetNPC}}.Location.BusStop}}",
        
        // --- GOSSIP (Conditional Reactivity) ---
        // Triggered if the NPC is in Town and specific conditions are met (often checked via schedule keys)
        "Town_{{ModId}}_OtherNPC": "{{i18n:{{TargetNPC}}.Gossip.OtherNPC}}",

        // --- ITEM INTERACTIONS ---
        "DumpsterDiveComment": "{{i18n:{{TargetNPC}}.Reaction.Trash}}",
        "AcceptGift_(O)PrismaticShard": "{{i18n:{{TargetNPC}}.Gift.Prismatic}}",
        "AcceptGift_category_weapon": "{{i18n:{{TargetNPC}}.Gift.Weapon}}",
        "AcceptGift_{{ModId}}_CustomItem": "{{i18n:{{TargetNPC}}.Gift.Custom}}",

        // --- WORLD STATE REACTIONS ---
        "cc_Complete": "{{i18n:{{TargetNPC}}.Reaction.CC_Done}}",
        "joja_Complete": "{{i18n:{{TargetNPC}}.Reaction.Joja_Done}}",
        "LowHealth": "{{i18n:{{TargetNPC}}.Reaction.PlayerHurt}}"
      }
    },

   
  ]
}
