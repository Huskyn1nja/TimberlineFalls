{
  "Changes": [
    // ============================================================
    // 1. ASSET LOADING
    // ============================================================
    {
      "LogName": "Load Assets (Sprite & Portrait)",
      "Action": "Load",
      "Target": "Characters/{{ModId}}_{{TargetNPC}}, Portraits/{{ModId}}_{{TargetNPC}}",
      "FromFile": "characters/{{TargetNPC}}/{{TargetNPC}}_{{TargetField}}.png"
    },
    {
      "LogName": "Load Base Schedule",
      "Action": "Load",
      "Target": "Characters/schedules/{{ModId}}_{{TargetNPC}}",
      "FromFile": "characters/{{TargetNPC}}/schedule.json"
    },
    {
      "LogName": "Include Dialogue & Events",
      "Action": "Include",
      "FromFile": "characters/{{TargetNPC}}/dialogue.json, characters/{{TargetNPC}}/events.json"
    },

    // ============================================================
    // 2. CHARACTER DEFINITION (1.6 Schema)
    // ============================================================
    {
      "LogName": "Profile Data",
      "Action": "EditData",
      "Target": "Data/Characters",
      "Entries": {
        "{{ModId}}_{{TargetNPC}}": {
          "DisplayName": "{{i18n:{{TargetNPC}}.Name}}",
          "TextureName": "{{ModId}}_{{TargetNPC}}", // Optional if matches ID
          "BirthSeason": "Spring", // Spring, Summer, Fall, Winter
          "BirthDay": 1,
          "HomeRegion": "Town",
          "Gender": "Undefined", // Male, Female, Undefined
          "Age": "Adult", // Child, Teen, Adult
          "Manner": "Neutral", // Polite, Rude, Neutral
          "SocialAnxiety": "Neutral", // Outgoing, Shy, Neutral
          "Optimism": "Neutral", // Positive, Negative, Neutral
          
          // Disposition
          "CanBeRomanced": true,
          "CanReceiveGifts": true,
          "CanVisitIsland": true,
          "WinterStarParticipant": true,
          "PerfectionScore": true,
          "IsDarkSkinned": false, // Changes footstep sounds/palette logic

          // Relationships & Items
          "EngagementItem": "{{ModId}}_CustomItemName", // Optional override
          "FriendsAndFamily": {
            // "OtherNPC_ID": "relationship_type" (e.g., 'mentor', 'acquaintance', 'rival')
          },
          "WinterStarGifts": [
            { "Id": "ItemName", "ItemId": "(O)ItemIndex", "MinStack": 1, "MaxStack": 5 }
          ],

          // 1.6 Pathfinding & Housing
          "Home": [
            {
              "Id": "Default",
              "Location": "Custom_LocationName",
              "Tile": { "X": 0, "Y": 0 },
              "Direction": "Down"
            }
          ],
          "SpouseRoom": {
            "MapAsset": "Maps/{{TargetNPC}}_SpouseRoom",
            "MapSourceRect": { "X": 0, "Y": 0, "Width": 6, "Height": 9 }
          },
          "SpousePatio": {
            "MapAsset": "Maps/{{TargetNPC}}_SpousePatio",
            "MapSourceRect": { "X": 0, "Y": 0, "Width": 4, "Height": 4 },
            "SpriteAnimationFrames": [[16, 500], [17, 500]] // Optional custom animation
          }
        }
      }
    },

    // ============================================================
    // 3. GIFT TASTES & MOVIES
    // ============================================================
    {
      "LogName": "Gift Tastes",
      "Action": "EditData",
      "Target": "Data/NPCGiftTastes",
      "Entries": {
        "{{ModId}}_{{TargetNPC}}": "{{i18n:{{TargetNPC}}.Gift.Love}}/ItemIDs/{{i18n:{{TargetNPC}}.Gift.Like}}/ItemIDs/{{i18n:{{TargetNPC}}.Gift.Dislike}}/ItemIDs/{{i18n:{{TargetNPC}}.Gift.Hate}}/ItemIDs/{{i18n:{{TargetNPC}}.Gift.Neutral}}/ItemIDs"
      }
    },
    {
      "LogName": "Movie Concession Tastes",
      "Action": "EditData",
      "Target": "Data/ConcessionTastes",
      "Entries": {
        "{{ModId}}_{{TargetNPC}}": {
          "Name": "{{ModId}}_{{TargetNPC}}",
          "LovedTags": ["Tag1", "Tag2"], // e.g. Sweet, Salty, Sour, Candy, Healthy
          "LikedTags": [],
          "DislikedTags": [],
          "HatedTags": []
        }
      }
    },
    {
      "LogName": "Movie Reactions",
      "Action": "EditData",
      "Target": "Data/MoviesReactions",
      "Entries": {
        "{{ModId}}_{{TargetNPC}}": {
          "NPCName": "{{ModId}}_{{TargetNPC}}",
          "Reactions": [
            // Reactions: love, like, dislike, hate
            { "Tag": "spring_movie_0", "Response": "neutral" },
            { "Tag": "summer_movie_1", "Response": "neutral" },
            { "Tag": "fall_movie_0", "Response": "neutral" },
            { "Tag": "winter_movie_0", "Response": "neutral" }
          ]
        }
      }
    },

    // ============================================================
    // 4. ANIMATIONS & DESCRIPTIONS
    // ============================================================
    {
      "LogName": "Animation Definitions",
      "Action": "EditData",
      "Target": "Data/animationDescriptions",
      "Entries": {
        // Syntax: "Frame/FrameDuration.../LoopFrame/StringKey/Offset"
        "{{TargetNPC}}_custom_anim": "16/100 17/100/16/Strings\\animationDescriptions:{{TargetNPC}}.AnimName"
      }
    },
    {
      "LogName": "Animation Strings (i18n)",
      "Action": "EditData",
      "Target": "Strings/animationDescriptions",
      "Entries": {
        "{{TargetNPC}}.AnimName": "{{i18n:{{TargetNPC}}.Animation.Description}}"
      }
    },

    // ============================================================
    // 5. DIALOGUE OVERRIDES & MAIL
    // ============================================================
    {
      "LogName": "Engagement & Marriage Dialogue",
      "Action": "EditData",
      "Target": "Data/EngagementDialogue",
      "Entries": {
        "{{ModId}}_{{TargetNPC}}0": "{{i18n:{{TargetNPC}}.Engagement.0}}", // Proposal Acceptance
        "{{ModId}}_{{TargetNPC}}1": "{{i18n:{{TargetNPC}}.Engagement.1}}"  // Post-Proposal
      }
    },
    {
      "LogName": "Misc Dialogue Overrides",
      "Action": "EditData",
      "Target": "Characters/Dialogue/{{ModId}}_{{TargetNPC}}",
      "Entries": {
        "AcceptBouquet": "{{i18n:{{TargetNPC}}.Dialogue.AcceptBouquet}}",
        "RejectBouquet": "{{i18n:{{TargetNPC}}.Dialogue.RejectBouquet}}",
        "FlowerDance_Accept": "{{i18n:{{TargetNPC}}.Dialogue.FlowerDance_Accept}}",
        "FlowerDance_Decline": "{{i18n:{{TargetNPC}}.Dialogue.FlowerDance_Decline}}",
        "SpouseStardrop": "{{i18n:{{TargetNPC}}.Dialogue.SpouseStardrop}}"
      }
    },
    {
      "LogName": "Mail Data",
      "Action": "EditData",
      "Target": "Data/mail",
      "Entries": {
        "{{ModId}}_{{TargetNPC}}_Welcome": "{{i18n:{{TargetNPC}}.Mail.Welcome}}"
      }
    },

    // ============================================================
    // 6. COMPLEX SCHEDULING (IF NEEDED)
    // ============================================================
    
    // Pattern: Heart Level Changes
    {
      "LogName": "Schedule - High Hearts",
      "Action": "EditData",
      "Target": "Characters/schedules/{{ModId}}_{{TargetNPC}}",
      "Entries": {
        "DayOfWeek": "Time Location X Y Facing Animation \"DialogueKey\""
      },
      "When": {
        "Hearts:{{ModId}}_{{TargetNPC}}": "6, 7, 8, 9, 10"
      }
    },

    // Pattern: Flag/World State Changes
    {
      "LogName": "Schedule - World State Change",
      "Action": "EditData",
      "Target": "Characters/schedules/{{ModId}}_{{TargetNPC}}",
      "Entries": {
        "Season": "GOTO RoutineName"
      },
      "When": {
        "HasFlag": "Condition_Flag_Here",
        // OR
        "Query: 'WORLD_STATE_FIELD LostBooksFound 20 999'": "true"
      }
    },

    // Pattern: Marriage Schedule
    {
      "LogName": "Schedule - Marriage",
      "Action": "EditData",
      "Target": "Characters/schedules/{{ModId}}_{{TargetNPC}}",
      "Entries": {
        "marriage_Mon": "800 Location X Y Facing/...",
        "marriage_default": "..."
      },
      "When": {
        "Relationship:{{ModId}}_{{TargetNPC}}": "Married"
      }
    },

    // ============================================================
    // 7. LOCATION MODIFIERS (IF NEEDED)
    // ============================================================
    {
      "LogName": "Conditional Forage/Spawns",
      "Action": "EditData",
      "Target": "Data/Locations",
      "TargetField": [ "Custom_LocationName", "Forage" ],
      "Entries": {
        "{{ModId}}_ItemName": 1.0
      },
      "When": {
        "Weather": "Storm", 
        "HasConversationTopic": "{{ModId}}_{{TargetNPC}}_Quest_Started"
      }
    }
  ]
}

