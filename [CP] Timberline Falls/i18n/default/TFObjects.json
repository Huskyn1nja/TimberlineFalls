	// Fish
	"Fish.BlushingPuffer.Name": "Blushing Puffer",
	"Fish.BlushingPuffer.Desc": "A bashful fish that puffs up when scared. It looks like a peach floating in the water.",
	"Fish.VeridianGlider.Name": "Veridian Glider",
	"Fish.VeridianGlider.Desc": "It glides across the water using its leaf-like fins. Many mistake it for a floating leaf.",
